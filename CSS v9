/* ===== BOX CUSTOMIZATION SETTINGS ===== */
.charsheet .hm-sheet {
  /* Main box border thickness */
  --box-border-width: 2px;
  /* Main box border color */
  --box-border-color: #171717;
  /* Box corner roundness */
  --box-border-radius: 4px;
  /* Shadow horizontal offset */
  --box-shadow-x: 2px;
  /* Shadow vertical offset */
  --box-shadow-y: 3px;
  /* Shadow blur amount */
  --box-shadow-blur: 5px;
  /* Shadow spread amount */
  --box-shadow-spread: 0px;
  /* Shadow color and transparency */
  --box-shadow-color: rgba(0, 0, 0, 0.25);
}

/* ===== BOX CUSTOMIZATION APPLICATION ===== */
.charsheet .hm-sheet .hm-stat,
.charsheet .hm-sheet .hm-aura,
.charsheet .hm-sheet .hm-resource,
.charsheet .hm-sheet .hm-combat,
.charsheet .hm-sheet .hm-ident,
.charsheet .hm-sheet .hm-deaths,
.charsheet .hm-sheet .hm-komt,
.charsheet .hm-sheet .hm-notes label,
.charsheet .hm-sheet .hm-panels,
.charsheet .hm-sheet .hm-action-card,
.charsheet .hm-sheet .hm-action-editor,
.charsheet .hm-sheet .hm-essence-slot {
  /* Apply the customizable border thickness and color */
  border: var(--box-border-width) solid var(--box-border-color);
  /* Apply the customizable corner radius */
  border-radius: var(--box-border-radius);
  /* Apply the customizable shadow */
  box-shadow: var(--box-shadow-x) var(--box-shadow-y) var(--box-shadow-blur) var(--box-shadow-spread) var(--box-shadow-color);
  /* Include the border in the element's allocated dimensions */
  box-sizing: border-box;
}

/* ===== STAT AND AURA LAYOUT ===== */
.charsheet .hm-sheet .hm-stat-score {
  /* Center the main stat value without a visible modifier field */
  justify-content: center;
}
.charsheet .hm-sheet .hm-aura-strength {
  /* Space reserved for Aura minimum, maximum, and Strength label */
  height: 90px;
  /* Stack Aura fields vertically */
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  gap: 6px;
}
.charsheet .hm-sheet .hm-aura-values {
  /* Align the minimum and maximum values on one line */
  display: flex;
  align-items: end;
  justify-content: center;
  gap: 5px;
  width: 100%;
}
.charsheet .hm-sheet .hm-aura-values label {
  /* Display the Minimum and Maximum labels above their fields */
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 10px;
  color: #000000;
}
.charsheet .hm-sheet .hm-aura-values input {
  /* Set the width of the Aura value fields */
  width: 48px;
  max-width: 48px;
}
.charsheet .hm-sheet .hm-aura-values > span {
  /* Style the slash between Aura values */
  font-size: 19px;
  color: #000000;
}
.charsheet .hm-sheet .hm-aura-strength-label {
  /* Display Strength as text only, without an input */
  font-size: 12px;
  color: #000000;
  font-weight: bold;
}

