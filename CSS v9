/* ===== RANK BADGE IMAGE ALIGNMENT CONTROLS ===== */
.charsheet .hm-sheet {
  /* Badge image area height, including the three stars */
  --badge-image-height: 160px;
  /* Background image horizontal adjustment */
  --badge-background-x: 0px;
  /* Background image vertical adjustment */
  --badge-background-y: 0px;
  /* Background image scale */
  --badge-background-scale: 1;
  /* Foreground outline horizontal adjustment */
  --badge-outline-x: -3px;
  /* Foreground outline vertical adjustment */
  --badge-outline-y: -2px;
  /* Foreground outline scale */
  --badge-outline-scale: 1;
  /* Clickable black star size */
  --badge-star-size: 29px;
  /* Star position from the bottom of the badge image */
  --badge-star-bottom: 3px;
  /* First star center position */
  --badge-star-left: 20%;
  /* Middle star center position */
  --badge-star-middle: 50%;
  /* Third star center position */
  --badge-star-right: 80%;
}
.charsheet .hm-sheet .hm-aura h4 {
  /* Reduce excess space above the badge */
  margin: 3px 0;
  line-height: 1.1;
}
.charsheet .hm-sheet .hm-shield {
  /* The shield and its stars share one positioning coordinate system */
  position: relative;
  width: 100%;
  height: var(--badge-image-height);
  margin: 0 auto;
  overflow: hidden;
  background: none;
}
.charsheet .hm-sheet .hm-shield img.hm-shield-rank,
.charsheet .hm-sheet .hm-shield img.hm-shield-overlay {
  /* All image layers use exactly the same dimensions and origin */
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  object-fit: fill;
  object-position: center;
  border: 0;
  margin: 0;
  padding: 0;
  pointer-events: none;
}
.charsheet .hm-sheet .hm-shield img.hm-shield-rank {
  /* Fine adjustment for the selected rank artwork */
  transform: translate(var(--badge-background-x), var(--badge-background-y)) scale(var(--badge-background-scale));
  transform-origin: center center;
  z-index: 1;
}
.charsheet .hm-sheet .hm-shield img.hm-shield-overlay {
  /* Fine adjustment for the transparent shield outline */
  transform: translate(var(--badge-outline-x), var(--badge-outline-y)) scale(var(--badge-outline-scale));
  transform-origin: center center;
  z-index: 2;
  display: block;
}
.charsheet .hm-sheet .hm-shield .hm-stars {
  /* Stars are over the stars already printed in the rank artwork */
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 3;
  pointer-events: none;
}
.charsheet .hm-sheet .hm-shield .hm-stars label {
  /* Each invisible hit area matches the printed star location */
  position: absolute;
  bottom: var(--badge-star-bottom);
  width: var(--badge-star-size);
  height: var(--badge-star-size);
  transform: translateX(-50%);
  pointer-events: auto;
  cursor: pointer;
}
.charsheet .hm-sheet .hm-shield .hm-stars .hm-star-one { left: var(--badge-star-left); }
.charsheet .hm-sheet .hm-shield .hm-stars .hm-star-two { left: var(--badge-star-middle); }
.charsheet .hm-sheet .hm-shield .hm-stars .hm-star-three { left: var(--badge-star-right); }
.charsheet .hm-sheet .hm-shield .hm-stars span,
.charsheet .hm-sheet .hm-shield .hm-stars span::before {
  /* Unchecked stars draw nothing, leaving the printed artwork visible */
  background: transparent;
  box-shadow: none;
  text-shadow: none;
}
.charsheet .hm-sheet .hm-shield .hm-stars input:checked + span::before {
  /* Checked stars cover the printed star interior with black */
  background: #000000 !important;
  clip-path: polygon(50% 3%,62% 36%,98% 36%,69% 57%,80% 94%,50% 72%,20% 94%,31% 57%,2% 36%,38% 36%);
}

