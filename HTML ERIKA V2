<script type="text/worker">
const statSkills = {
  power: ["athletics", "intimidation", "endurance"],
  speed_stat: ["acrobatics", "sneak", "reflexes"],
  spirit: ["magic", "social", "lore"],
  recovery: ["medicine", "survival", "sanity"]
};

function signedModifier(score) {
  return Math.floor((Number(score || 10) - 10) / 2);
}

function updateSheet() {
  getAttrs([
    "power", "speed_stat", "spirit", "recovery", "proficiency_bonus",
    "athletics_prof", "intimidation_prof", "endurance_prof",
    "acrobatics_prof", "sneak_prof", "reflexes_prof",
    "magic_prof", "social_prof", "lore_prof",
    "medicine_prof", "survival_prof", "sanity_prof"
  ], function(values) {
    const prof = Number(values.proficiency_bonus || 0);
    const updates = {
      power_mod: signedModifier(values.power),
      speed_stat_mod: signedModifier(values.speed_stat),
      spirit_mod: signedModifier(values.spirit),
      recovery_mod: signedModifier(values.recovery)
    };

    Object.keys(statSkills).forEach(function(statName) {
      const statMod = signedModifier(values[statName]);
      statSkills[statName].forEach(function(skill) {
        updates[skill] = statMod + (values[skill + "_prof"] === "1" ? prof : 0);
      });
    });

    setAttrs(updates);
  });
}

