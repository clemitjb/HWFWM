<script type="text/worker">
on("change:rank sheet:opened", () => {
  getAttrs(["rank", "rank_visual"], v => {
    const allowed = ["Iron", "Bronze", "Silver", "Gold"];
    const rank = allowed.includes(v.rank) ? v.rank : "Iron";
    if (v.rank_visual !== rank) setAttrs({rank_visual: rank});
  });
});
const stats = ["power", "speed", "spirit", "recovery"];
stats.forEach(stat => {
  on(`change:${stat} sheet:opened`, () => {
    getAttrs([stat], values => {
      const score = Number(values[stat]) || 0;
      setAttrs({[`${stat}_mod`]: Math.floor((score - 10) / 2)});
    });
  });
});

on("clicked:long_rest clicked:short_rest", () => {
  getAttrs(["hp_max", "mana_max"], values => {
    const updates = {};
    ["hp", "mana"].forEach(resource => {
      const maximum = Number(values[resource + "_max"]);
      if (values[resource + "_max"] !== "" && Number.isFinite(maximum)) {
        updates[resource] = Math.max(0, maximum);
      }
    });
    if (Object.keys(updates).length) setAttrs(updates);
  });
});

on("sheet:opened", () => { getAttrs(["sheet_tab"], v => { if (v.sheet_tab === "abilities") setAttrs({sheet_tab:"attacks"}); }); });
</script>
